# ── Secrets — NEVER commit these ─────────────────────────────────────────
.env
.env.*
.env.local
*.env
kaggle.json
.kaggle/
*_credentials*
*_secrets*
*_apikey*

# ── Python runtime ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model artifacts (large binaries) ──────────────────────────────────────
results/models/*.pt
results/models/*.pth
results/models/*.ckpt
*.pt
*.pth
*.ckpt
*.bin

# ── Dataset — stays on Kaggle, never committed ────────────────────────────
/data/
*.zip
*.tar.gz
*.tgz

# ── Experiment outputs ─────────────────────────────────────────────────────
results/uncertainty/
results/cbr/
results/explainability/
results/gradcam/
results/attention_maps/
results/plots/
results/statistics/
# Keep reproducibility artifacts
!results/reproducibility/

# ── Notebooks (may contain outputs with paths/data) ───────────────────────
notebooks/*.ipynb

# ── IDE / OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Coverage / test artifacts ─────────────────────────────────────────────
.coverage
.pytest_cache/
htmlcov/
coverage.xml
*.log
